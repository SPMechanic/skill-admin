{
  "description": "Activity ledger: records every skills/*/scripts/ invocation to .audit/activity.jsonl as executed evidence of plugin activity.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python \"${CLAUDE_PLUGIN_ROOT}/hooks/log_activity.py\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python \"${CLAUDE_PLUGIN_ROOT}/hooks/log_activity.py\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
